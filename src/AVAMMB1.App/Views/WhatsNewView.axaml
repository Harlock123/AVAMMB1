<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AVAMMB1.App.ViewModels"
             x:Class="AVAMMB1.App.Views.WhatsNewView" x:DataType="vm:WhatsNewViewModel">
  <Grid Background="{DynamicResource WindowBg}">
    <Border Classes="dialog" Width="900" Height="700" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="title" Text="{Binding Title}" Margin="0,0,0,8" />
        <Button DockPanel.Dock="Bottom" Content="Continue (Enter)" Command="{Binding CloseCommand}" HorizontalAlignment="Right" FontWeight="Bold" Margin="0,8,0,0" />
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Releases}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ReleaseView">
                <StackPanel Margin="0,0,0,14">
                  <TextBlock Text="{Binding Heading}" Classes="h2" />
                  <ItemsControl ItemsSource="{Binding Lines}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:NoteLine">
                        <TextBlock Text="{Binding Shown}" Margin="{Binding Indent}" TextWrapping="Wrap"
                                   Classes.dim="{Binding IsHeading}" FontWeight="{Binding Weight}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
