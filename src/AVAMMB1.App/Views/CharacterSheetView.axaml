<UserControl xmlns:l="using:AVAMMB1.App.Localization"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AVAMMB1.App.ViewModels"
             xmlns:c="using:AVAMMB1.App.Controls"
             x:Class="AVAMMB1.App.Views.CharacterSheetView" x:DataType="vm:CharacterSheetViewModel">
  <Border Classes="dialog" Width="1100" Height="660" Padding="14">
    <Grid ColumnDefinitions="260,14,*,14,*" RowDefinitions="Auto,*,Auto">
      <Grid Grid.ColumnSpan="5" ColumnDefinitions="Auto,*,Auto">
        <c:PixelImage Source="{Binding Member.Portrait}" Width="64" Height="64" Margin="0,0,10,0" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Classes="title" Text="{Binding Header}" />
          <TextBlock Text="{l:T 'Left/Right or 1-6 to switch characters; [ and ] to change their place in the party'}" Classes="dim" FontSize="{DynamicResource Font12}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="{l:T 'Move left ['}" Command="{Binding MoveLeftCommand}" IsEnabled="{Binding CanMoveLeft}" ToolTip.Tip="{l:T 'Move this character one place towards the front'}" />
          <Button Content="{l:T 'Move right ]'}" Command="{Binding MoveRightCommand}" IsEnabled="{Binding CanMoveRight}" Margin="0,0,12,0" ToolTip.Tip="{l:T 'Move this character one place towards the back'}" />
          <Button Content="{l:T '&lt; Prev'}" Command="{Binding PreviousCommand}" />
          <Button Content="{l:T 'Next &gt;'}" Command="{Binding NextCommand}" />
        </StackPanel>
      </Grid>

      <StackPanel Grid.Row="1" Margin="0,8,0,0" Spacing="2">
        <TextBlock Classes="h2" Text="{l:T 'Attributes'}" />
        <ItemsControl ItemsSource="{Binding Stats}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" FontFamily="monospace" /></DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="{DynamicResource Font13}" LineHeight="20" />
        <TextBlock Classes="h2" Text="{l:T 'Gold'}" />
        <TextBlock Text="{Binding GoldLine}" TextWrapping="Wrap" FontSize="{DynamicResource Font13}" Foreground="{DynamicResource Gold}" />
        <StackPanel Orientation="Horizontal" Spacing="2">
          <NumericUpDown Value="{Binding GoldAmount}" Minimum="0" Increment="10" FormatString="0" Width="110" />
          <Button Classes="chip" Content="{l:T 'Deposit'}" Command="{Binding DepositGoldCommand}" ToolTip.Tip="{l:T 'Put this much into the party purse'}" />
          <Button Classes="chip" Content="{l:T 'Withdraw'}" Command="{Binding WithdrawGoldCommand}" ToolTip.Tip="{l:T 'Take this much from the party purse'}" />
        </StackPanel>
        <WrapPanel>
          <Button Classes="chip" Content="{l:T 'Deposit all'}" Command="{Binding DepositAllGoldCommand}" />
          <Button Classes="chip" Content="{l:T 'Pool everyone'}" Command="{Binding PoolAllGoldCommand}" ToolTip.Tip="{l:T 'Everyone puts all their gold in the purse'}" />
          <Button Classes="chip" Content="{l:T 'Share evenly'}" Command="{Binding ShareGoldCommand}" ToolTip.Tip="{l:T 'Split the purse between all members'}" />
        </WrapPanel>
      </StackPanel>

      <DockPanel Grid.Row="1" Grid.Column="2" Margin="0,8,0,0">
        <TextBlock DockPanel.Dock="Top" Classes="h2" Text="{l:T 'Equipped'}" />
        <ItemsControl ItemsSource="{Binding Equipment}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ItemRow">
              <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="4,0" Margin="0,1" MinHeight="0"
                      Command="{Binding $parent[UserControl].((vm:CharacterSheetViewModel)DataContext).SelectCommand}" CommandParameter="{Binding}">
                <Grid ColumnDefinitions="70,30,*" Height="32">
                  <TextBlock Text="{Binding SlotLabel}" Classes="dim" VerticalAlignment="Center" FontSize="{DynamicResource Font12}" />
                  <Image Grid.Column="1" Classes="pixel" Source="{Binding Icon}" Width="24" Height="24" />
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Text="{Binding Detail}" FontSize="{DynamicResource Font11}" Classes="dim" />
                  </StackPanel>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>

      <DockPanel Grid.Row="1" Grid.Column="4" Margin="0,8,0,0">
        <TextBlock DockPanel.Dock="Top" Classes="h2" Text="{l:T 'Backpack'}" />
        <ScrollViewer>
          <StackPanel>
            <ItemsControl ItemsSource="{Binding Backpack}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ItemRow">
                  <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="4,2" Margin="0,1"
                          Command="{Binding $parent[UserControl].((vm:CharacterSheetViewModel)DataContext).SelectCommand}" CommandParameter="{Binding}">
                    <Grid ColumnDefinitions="36,*">
                      <c:PixelImage Source="{Binding Icon}" Width="28" Height="28" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" />
                        <TextBlock Text="{Binding Detail}" FontSize="{DynamicResource Font11}" Classes="dim" />
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="h2" Text="{l:T 'Spells'}" IsVisible="{Binding Spells.Count}" />
            <ItemsControl ItemsSource="{Binding Spells}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" FontSize="{DynamicResource Font12}" TextWrapping="Wrap" /></DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>

      <StackPanel Grid.Row="2" Grid.ColumnSpan="5" Spacing="4" Margin="0,8,0,0">
        <TextBlock Text="{Binding SelectedDescription}" Foreground="{DynamicResource Gold}" />
        <StackPanel Orientation="Horizontal" IsEnabled="{Binding HasSelection}">
          <Button Content="{l:T 'Equip / Remove'}" Command="{Binding EquipOrRemoveCommand}" />
          <Button Content="{l:T 'Use'}" Command="{Binding UseCommand}" />
          <Button Content="{l:T 'Drop'}" Command="{Binding DropCommand}" />
          <TextBlock Text="{l:T '  Give to:'}" VerticalAlignment="Center" Classes="dim" />
          <ItemsControl ItemsSource="{Binding Party}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PartyMemberViewModel">
                <Button Classes="chip" Content="{Binding Name}" Command="{Binding $parent[UserControl].((vm:CharacterSheetViewModel)DataContext).GiveCommand}" CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding Feedback}" Foreground="{DynamicResource Info}" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="{l:T 'Close (Esc)'}" Command="{Binding CloseCommand}" />
        </Grid>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
