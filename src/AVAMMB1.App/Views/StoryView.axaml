<UserControl xmlns:l="using:AVAMMB1.App.Localization"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AVAMMB1.App.ViewModels"
             x:Class="AVAMMB1.App.Views.StoryView" x:DataType="vm:StoryViewModel">
  <Border Classes="dialog" MaxWidth="640" MinWidth="420">
    <StackPanel Spacing="12">
      <TextBlock Classes="title" Text="{Binding Title}" />
      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="{DynamicResource Font16}" LineHeight="24" />
      <Button Content="{l:T 'Continue (Enter)'}" Command="{Binding OkCommand}" HorizontalAlignment="Right" FontWeight="Bold" />
    </StackPanel>
  </Border>
</UserControl>
