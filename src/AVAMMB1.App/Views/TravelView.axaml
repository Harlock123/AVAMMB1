<UserControl xmlns:l="using:AVAMMB1.App.Localization"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AVAMMB1.App.ViewModels"
             x:Class="AVAMMB1.App.Views.TravelView" x:DataType="vm:TravelViewModel">
  <Border Classes="dialog" MaxWidth="700" MinWidth="500">
    <StackPanel Spacing="10">
      <TextBlock Classes="title" Text="{l:T 'Travel map'}" />
      <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Classes="dim" />
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TravelRow">
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2"
                    Command="{Binding $parent[UserControl].((vm:TravelViewModel)DataContext).GoCommand}" CommandParameter="{Binding}">
              <StackPanel>
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Details}" FontSize="{DynamicResource Font12}" Classes="dim" TextWrapping="Wrap" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Content="{l:T 'Stay here (Esc)'}" Command="{Binding CloseCommand}" HorizontalAlignment="Right" />
    </StackPanel>
  </Border>
</UserControl>
