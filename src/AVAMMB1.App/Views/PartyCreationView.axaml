<UserControl xmlns:l="using:AVAMMB1.App.Localization"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AVAMMB1.App.ViewModels"
             xmlns:c="using:AVAMMB1.App.Controls"
             xmlns:ch="using:AVAMMB1.Core.Characters"
             x:Class="AVAMMB1.App.Views.PartyCreationView"
             x:DataType="vm:PartyCreationViewModel">
  <Grid Margin="16" ColumnDefinitions="*,16,360" RowDefinitions="Auto,*,Auto">
    <TextBlock Grid.ColumnSpan="3" Classes="title" Text="{Binding Title}" Margin="0,0,0,10" />

    <Border Grid.Row="1" Classes="panel">
      <Grid ColumnDefinitions="300,20,*" RowDefinitions="Auto,*">
        <!-- Attributes -->
        <StackPanel Spacing="4">
          <TextBlock Classes="h2" Text="{l:T 'Attributes'}" />
          <Grid ColumnDefinitions="110,50,40,50">
            <TextBlock Text="{l:T 'Attribute'}" Classes="dim" />
            <TextBlock Grid.Column="1" Text="{l:T 'Roll'}" Classes="dim" />
            <TextBlock Grid.Column="2" Text="{l:T 'Race'}" Classes="dim" />
            <TextBlock Grid.Column="3" Text="{l:T 'Final'}" Classes="dim" />
          </Grid>
          <ItemsControl ItemsSource="{Binding StatRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:StatRow">
                <Grid ColumnDefinitions="110,50,40,50" Margin="0,2">
                  <TextBlock Text="{Binding Name}" />
                  <TextBlock Grid.Column="1" Text="{Binding Raw}" />
                  <TextBlock Grid.Column="2" Text="{Binding Modifier}" Foreground="{DynamicResource Good}" />
                  <TextBlock Grid.Column="3" Text="{Binding Final}" FontWeight="Bold" Foreground="{DynamicResource Gold}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="{l:T 'Reroll Attributes'}" Command="{Binding RollCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
          <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,16,0,0">
            <Border BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" Background="{DynamicResource ScreenBg}" Padding="4">
              <c:PixelImage Source="{Binding Portrait}" Width="96" Height="96" />
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="6">
              <Grid ColumnDefinitions="*,Auto" Width="170">
                <TextBlock Text="{l:T 'Name'}" Classes="dim" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="chip" Content="{l:T 'Random'}" Command="{Binding RandomNameCommand}" ToolTip.Tip="{l:T 'A random name for this race'}" />
              </Grid>
              <TextBox Text="{Binding Name}" Width="170" MaxLength="16" Watermark="{l:T 'Enter a name'}" ToolTip.Tip="{l:T 'Type a name - with a controller, press A here for the on-screen keyboard'}" />
            </StackPanel>
          </StackPanel>
          <StackPanel Spacing="4" Margin="0,8,0,0" Width="290" HorizontalAlignment="Left">
            <Grid ColumnDefinitions="50,Auto,*,Auto">
                <TextBlock Text="{l:T 'Hair'}" Classes="dim" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="chip" Content="&lt;" Command="{Binding PreviousHairCommand}" ToolTip.Tip="{l:T 'Previous hairstyle'}" />
                <TextBlock Grid.Column="2" Text="{Binding HairLabel}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="{DynamicResource Font12}" />
                <Button Grid.Column="3" Classes="chip" Content="&gt;" Command="{Binding NextHairCommand}" ToolTip.Tip="{l:T 'Next hairstyle (a hairstyle leaves the helmet or hood off)'}" />
              </Grid>
            <Grid ColumnDefinitions="50,Auto,*,Auto">
                <TextBlock Text="{l:T 'Beard'}" Classes="dim" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="chip" Content="&lt;" Command="{Binding PreviousBeardCommand}" ToolTip.Tip="{l:T 'Previous beard'}" />
                <TextBlock Grid.Column="2" Text="{Binding BeardLabel}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="{DynamicResource Font12}" />
                <Button Grid.Column="3" Classes="chip" Content="&gt;" Command="{Binding NextBeardCommand}" ToolTip.Tip="{l:T 'Next beard'}" />
              </Grid>
          </StackPanel>
        </StackPanel>

        <!-- Choices -->
        <StackPanel Grid.Column="2" Spacing="4">
          <TextBlock Classes="h2" Text="{l:T 'Race'}" />
          <ListBox ItemsSource="{Binding Races}" SelectedItem="{Binding SelectedRace}" Background="Transparent">
            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ChoiceViewModel">
                <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Description}" Margin="4,0" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Orientation="Horizontal" Spacing="30">
            <StackPanel>
              <TextBlock Classes="h2" Text="{l:T 'Sex'}" />
              <ListBox ItemsSource="{Binding Sexes}" SelectedItem="{Binding SelectedSex}" Background="Transparent">
                <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ChoiceViewModel"><TextBlock Text="{Binding Name}" Margin="4,0" /></DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
            <StackPanel>
              <TextBlock Classes="h2" Text="{l:T 'Alignment'}" />
              <ListBox ItemsSource="{Binding Alignments}" SelectedItem="{Binding SelectedAlignment}" Background="Transparent">
                <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ChoiceViewModel"><TextBlock Text="{Binding Name}" Margin="4,0" /></DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </StackPanel>
          <TextBlock Classes="h2" Text="{l:T 'Class (greyed out classes need better attributes)'}" />
          <ItemsControl ItemsSource="{Binding Classes}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ChoiceViewModel">
                <Button Content="{Binding Name}" IsEnabled="{Binding IsEnabled}" ToolTip.Tip="{Binding Description}" MinWidth="110"
                        Command="{Binding $parent[UserControl].((vm:PartyCreationViewModel)DataContext).PickClassCommand}" CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Margin="0,6,0,0" TextWrapping="Wrap">
            <Run Text="{l:T 'Selected: '}" Foreground="{DynamicResource Dim}" />
            <Run Text="{Binding SelectedClass.Name, FallbackValue=none}" FontWeight="Bold" Foreground="{DynamicResource Gold}" />
          </TextBlock>
          <TextBlock Text="{Binding SelectedClass.Description, FallbackValue=''}" TextWrapping="Wrap" Classes="dim" />
          <TextBlock Text="{Binding Preview}" Margin="0,4,0,0" />
          <Button Content="{l:T 'Add Adventurer'}" Command="{Binding AddCharacterCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" FontWeight="Bold" />
          <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Good}" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Party list -->
    <Border Grid.Row="1" Grid.Column="2" Classes="panel">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="4">
          <TextBlock Classes="h2" Text="{l:T 'Your Party'}" />
          <TextBlock Text="{Binding PartySummary}" Classes="dim" />
          <Button Content="{l:T 'Quick Party (6 premade heroes)'}" Command="{Binding QuickPartyCommand}" IsVisible="{Binding !RecruitMode}" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Created}" Margin="0,8,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="ch:Character">
              <Border Background="{DynamicResource CardBg}" CornerRadius="3" Padding="8,4" Margin="0,2">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                    <TextBlock Classes="dim" FontSize="{DynamicResource Font12}">
                      <Run Text="{Binding Race}" /><Run Text=" " /><Run Text="{Binding Class}" /><Run Text="{l:T '  HP '}" /><Run Text="{Binding MaxHp}" /><Run Text="{l:T '  SP '}" /><Run Text="{Binding MaxSp}" />
                    </TextBlock>
                  </StackPanel>
                  <Button Grid.Column="1" Classes="chip" Content="{l:T 'Remove'}"
                          Command="{Binding $parent[UserControl].((vm:PartyCreationViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Border>

    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" Spacing="8">
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !RecruitMode}" VerticalAlignment="Center" Margin="0,0,16,0">
        <TextBlock Text="{l:T 'Difficulty'}" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding DifficultyOptions}" SelectedIndex="{Binding DifficultyIndex}" Width="110" ToolTip.Tip="{Binding DifficultyText}" />
        <CheckBox Content="{l:T 'Survival mode'}" IsChecked="{Binding Survival}" ToolTip.Tip="{l:T 'Everyone eats 1 food a day as well as when resting, and goes hungry without. Can be changed later in Settings.'}" />
        <CheckBox Content="{l:T 'Ironman'}" IsChecked="{Binding Ironman}" ToolTip.Tip="{l:T 'One save, kept by the game as you play - no reloading. If the whole party falls, the run is over and goes into the Hall of Fame. Cannot be changed later.'}" />
      </StackPanel>
      <Button Content="{l:T 'Back (Esc)'}" Command="{Binding BackCommand}" />
      <Button Content="{l:T 'Begin the Adventure'}" Command="{Binding BeginCommand}" FontWeight="Bold" IsVisible="{Binding !RecruitMode}" />
    </StackPanel>
  </Grid>
</UserControl>
