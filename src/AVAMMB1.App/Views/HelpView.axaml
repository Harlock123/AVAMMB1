<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AVAMMB1.App.ViewModels"
             x:Class="AVAMMB1.App.Views.HelpView" x:DataType="vm:HelpViewModel">
  <Border Classes="dialog" Width="960" Height="680" HorizontalAlignment="Center" VerticalAlignment="Center">
    <DockPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
        <TextBlock Classes="title" Text="Help" />
        <Button Grid.Column="1" Content="Close (F1)" Command="{Binding CloseCommand}" />
      </Grid>
      <TabControl>
        <TabItem Header="How to play">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Basics}" Margin="0,6">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HelpRow">
                  <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="{Binding Name}" Classes="h2" />
                    <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Keyboard">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Keys}" Margin="0,6">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HelpRow">
                  <Grid ColumnDefinitions="360,*" Margin="0,2">
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{DynamicResource Gold}" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Controller">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Pad}" Margin="0,6">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HelpRow">
                  <Grid ColumnDefinitions="360,*" Margin="0,2">
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{DynamicResource Gold}" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </DockPanel>
  </Border>
</UserControl>
