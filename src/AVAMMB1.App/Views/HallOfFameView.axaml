<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AVAMMB1.App.ViewModels"
             x:Class="AVAMMB1.App.Views.HallOfFameView" x:DataType="vm:HallOfFameViewModel">
  <Grid Background="{DynamicResource WindowBg}">
    <Border Classes="dialog" Width="1000" Height="700" HorizontalAlignment="Center" VerticalAlignment="Center">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Classes="title" Text="Hall of Fame" />
            <TextBlock Text="{Binding Summary}" Classes="dim" />
            <TextBlock Text="{Binding Daily}" Foreground="{DynamicResource Gold}" />
          </StackPanel>
          <Button Grid.Column="1" Content="Back (Esc)" Command="{Binding BackCommand}" VerticalAlignment="Top" />
        </Grid>
        <Grid ColumnDefinitions="3*,24,2*">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Entries}" Margin="0,0,12,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HallEntryRow">
                  <StackPanel Margin="0,0,0,12" Spacing="1" Classes.won="{Binding Won}">
                    <StackPanel.Styles>
                      <Style Selector="StackPanel TextBlock.head"><Setter Property="Foreground" Value="{DynamicResource Dim}" /></Style>
                      <Style Selector="StackPanel.won TextBlock.head"><Setter Property="Foreground" Value="{DynamicResource Gold}" /></Style>
                    </StackPanel.Styles>
                    <TextBlock Classes="head" Text="{Binding Heading}" FontWeight="Bold" />
                    <TextBlock Text="{Binding Party}" TextWrapping="Wrap" FontSize="{DynamicResource Font12}" />
                    <TextBlock Text="{Binding Details}" TextWrapping="Wrap" FontSize="{DynamicResource Font12}" Classes="dim" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Classes="h2" Text="{Binding AchievementCount}" TextWrapping="Wrap" />
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Achievements}" Margin="0,0,12,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AchievementRow">
                    <Grid ColumnDefinitions="22,*" Margin="0,2" Classes.earned="{Binding Earned}">
                      <Grid.Styles>
                        <Style Selector="Grid TextBlock"><Setter Property="Opacity" Value="0.55" /></Style>
                        <Style Selector="Grid.earned TextBlock"><Setter Property="Opacity" Value="1" /></Style>
                      </Grid.Styles>
                      <TextBlock Text="{Binding Mark}" Foreground="{DynamicResource Good}" FontWeight="Bold" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Description}" FontSize="{DynamicResource Font12}" Classes="dim" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Grid>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
