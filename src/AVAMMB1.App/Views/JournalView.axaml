<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AVAMMB1.App.ViewModels"
             xmlns:s="using:AVAMMB1.Core.Session"
             xmlns:c="using:AVAMMB1.App.Controls"
             x:Class="AVAMMB1.App.Views.JournalView" x:DataType="vm:JournalViewModel">
  <Border Classes="dialog" Width="900" Height="600">
    <DockPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
        <TextBlock Classes="title" Text="Journal" />
        <Button Grid.Column="1" Content="Close (J)" Command="{Binding CloseCommand}" />
      </Grid>
      <TabControl SelectedIndex="{Binding Tab}">
        <TabItem Header="Quests">
          <ScrollViewer>
            <StackPanel Spacing="12" Margin="0,6">
              <TextBlock IsVisible="{Binding NoQuests}" Classes="dim" TextWrapping="Wrap"
                         Text="No quests yet. Talk to the people of Brindlemoor - Archivist Pell is said to be looking for adventurers." />
              <ItemsControl ItemsSource="{Binding Quests}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:JournalQuest">
                    <StackPanel Spacing="3" Margin="0,0,0,12">
                      <TextBlock Text="{Binding Heading}" Classes="h2" />
                      <ItemsControl ItemsSource="{Binding Earlier}" IsVisible="{Binding HasEarlier}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" Classes="dim" TextWrapping="Wrap" Margin="12,0,0,2" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="{Binding Current}" TextWrapping="Wrap" Margin="12,0,0,0" />
                      <TextBlock Text="{Binding Next}" IsVisible="{Binding HasNext}" Foreground="{DynamicResource MapQuest}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="12,2,0,0" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Bestiary">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding BestiaryCount}" Classes="dim" Margin="0,6,0,6" />
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Bestiary}" Margin="0,0,12,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BestiaryEntry">
                    <Grid ColumnDefinitions="72,*" Margin="0,0,0,12">
                      <Border Width="64" Height="64" Background="{DynamicResource ScreenBg}" CornerRadius="3" VerticalAlignment="Top">
                        <c:PixelImage Source="{Binding Sprite}" Width="64" Height="64" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="1">
                        <TextBlock><Run Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource Gold}" /><Run Text="   " /><Run Text="{Binding KillText}" Foreground="{DynamicResource Dim}" /></TextBlock>
                        <TextBlock Text="{Binding Stats}" FontSize="{DynamicResource Font12}" />
                        <TextBlock Text="{Binding Attacks}" FontSize="{DynamicResource Font12}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Defenses}" FontSize="{DynamicResource Font12}" Foreground="{DynamicResource Info}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Found}" IsVisible="{Binding HasFound}" FontSize="{DynamicResource Font12}" Classes="dim" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Description}" FontSize="{DynamicResource Font12}" FontStyle="Italic" Classes="dim" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </TabItem>
        <TabItem Header="Items">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding ItemsCount}" Classes="dim" Margin="0,6,0,6" />
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,12,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ItemEntry">
                    <Grid ColumnDefinitions="44,*" Margin="0,0,0,8">
                      <c:PixelImage Source="{Binding Icon}" Width="32" Height="32" VerticalAlignment="Top" />
                      <StackPanel Grid.Column="1" Spacing="1">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                        <TextBlock Text="{Binding Summary}" FontSize="{DynamicResource Font12}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Classes}" IsVisible="{Binding HasClasses}" FontSize="{DynamicResource Font12}" Classes="dim" />
                        <TextBlock Text="{Binding Description}" FontSize="{DynamicResource Font12}" FontStyle="Italic" Classes="dim" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </TabItem>
        <TabItem Header="Clues">
          <ScrollViewer>
            <StackPanel Spacing="10" Margin="0,6">
              <TextBlock IsVisible="{Binding NoDiscoveries}" Classes="dim" Text="Signs, inscriptions and warnings you read are collected here." />
              <ItemsControl ItemsSource="{Binding Discoveries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="s:Discovery">
                    <StackPanel Margin="0,0,0,10">
                      <TextBlock>
                        <Run Text="{Binding Name}" FontWeight="Bold" />
                        <Run Text=" - " />
                        <Run Text="{Binding Place}" />
                      </TextBlock>
                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="12,2,0,0" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </DockPanel>
  </Border>
</UserControl>
