<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AVAMMB1.App.ViewModels"
             x:Class="AVAMMB1.App.Views.SettingsView" x:DataType="vm:SettingsViewModel">
  <Grid Background="#0c0b12">
    <Border Classes="dialog" Width="820" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Grid ColumnDefinitions="*,24,*" RowDefinitions="Auto,*,Auto">
        <TextBlock Grid.ColumnSpan="3" Classes="title" Text="Settings" Margin="0,0,0,8" />
        <StackPanel Grid.Row="1" Spacing="6">
          <TextBlock Classes="h2" Text="Audio" />
          <TextBlock Text="{Binding MusicVolume, StringFormat='Music volume: {0}'}" />
          <Slider Minimum="0" Maximum="100" Value="{Binding MusicVolume}" TickFrequency="5" IsSnapToTickEnabled="True" />
          <TextBlock Text="{Binding SfxVolume, StringFormat='Effects volume: {0}'}" />
          <Slider Minimum="0" Maximum="100" Value="{Binding SfxVolume}" TickFrequency="5" IsSnapToTickEnabled="True" />
          <TextBlock Text="{Binding AudioStatus}" Classes="dim" FontSize="12" />
          <TextBlock Classes="h2" Text="Display" />
          <CheckBox Content="Fullscreen (F11 toggles)" IsChecked="{Binding Fullscreen}" />
          <CheckBox Content="Fit interface to window (scales for small and large screens)" IsChecked="{Binding FitToWindow}" />
          <CheckBox Content="Show minimap" IsChecked="{Binding ShowMinimap}" />
          <CheckBox Content="Smooth movement (animated steps and turns)" IsChecked="{Binding SmoothMovement}" />
          <CheckBox Content="Animated monsters in combat" IsChecked="{Binding AnimateMonsters}" />
          <TextBlock Classes="h2" Text="Controller" />
          <CheckBox Content="Use gamepad" IsChecked="{Binding GamepadEnabled}" />
          <TextBlock Text="{Binding GamepadStatus}" Classes="dim" FontSize="12" TextWrapping="Wrap" />
          <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap"
                     Text="Explore: D-pad/stick move, LB/RB strafe, A use, X search, Y party, View map, Start menu, LT rest, RT cast. Battle: A attack, X cast, Y item, B block, LB/RB target. Menus: D-pad moves, A selects, B back." />
          <TextBlock Classes="h2" Text="Data" />
          <TextBlock Text="{Binding DataLocation}" Classes="dim" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="2" Spacing="2">
          <TextBlock Classes="h2" Text="Key Bindings" />
          <ItemsControl ItemsSource="{Binding Bindings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BindingRow">
                <Grid ColumnDefinitions="130,*,Auto" Margin="0,1">
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Keys}" VerticalAlignment="Center" Foreground="{StaticResource Gold}" />
                  <Button Grid.Column="2" Classes="chip" Content="Rebind"
                          Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).RebindCommand}" CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding Hint}" Foreground="#9fd0ff" TextWrapping="Wrap" />
          <Button Content="Reset to defaults" Command="{Binding ResetBindingsCommand}" HorizontalAlignment="Left" />
        </StackPanel>
        <Button Grid.Row="2" Grid.ColumnSpan="3" Content="Save &amp; Back" Command="{Binding BackCommand}" HorizontalAlignment="Right" FontWeight="Bold" Margin="0,10,0,0" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
