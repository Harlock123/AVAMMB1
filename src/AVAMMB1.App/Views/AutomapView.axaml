<UserControl xmlns:l="using:AVAMMB1.App.Localization"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AVAMMB1.App.ViewModels"
             xmlns:c="using:AVAMMB1.App.Controls"
             x:Class="AVAMMB1.App.Views.AutomapView" x:DataType="vm:AutomapViewModel">
  <Border Classes="dialog" Width="1000" Height="600">
    <DockPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
        <TextBlock Classes="title" Text="{Binding Title}" />
        <TextBlock Grid.Column="1" Text="{Binding Position}" VerticalAlignment="Center" />
      </Grid>
      <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
        <WrapPanel.Styles>
          <Style Selector="TextBlock"><Setter Property="Margin" Value="0,0,14,0" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
        </WrapPanel.Styles>
        <TextBlock Text="{l:T '&#x25CF; services'}" Foreground="{DynamicResource MapServices}" />
        <TextBlock Text="{l:T '&#x25CF; passages'}" Foreground="{DynamicResource MapPassage}" />
        <TextBlock Text="{l:T '&#x25CF; treasure'}" Foreground="{DynamicResource MapTreasure}" />
        <TextBlock Text="{l:T '&#x25CF; fountain'}" Foreground="{DynamicResource MapFountain}" />
        <TextBlock Text="{l:T '&#x25CF; quest'}" Foreground="{DynamicResource MapQuest}" />
        <TextBlock Text="{l:T '&#x25C6; where next'}" Foreground="{DynamicResource MapQuest}" />
        <TextBlock Text="{l:T '&#x25A0; note'}" Foreground="{DynamicResource MapNote}" />
        <TextBlock Text="{l:T '&#x2501; door'}" Foreground="{DynamicResource MapDoor}" />
        <TextBlock Text="{l:T '&#x2501; locked'}" Foreground="{DynamicResource MapLocked}" />
        <TextBlock Text="{l:T '&#x2501; secret'}" Foreground="{DynamicResource MapSecret}" />
        <Button Content="{l:T 'Close (M)'}" Command="{Binding CloseCommand}" />
      </WrapPanel>
      <DockPanel DockPanel.Dock="Right" Width="270" Margin="10,0,0,0">
        <StackPanel DockPanel.Dock="Top" Spacing="4">
          <StackPanel IsVisible="{Binding HasGoals}" Spacing="2" Margin="0,0,0,8">
            <TextBlock Classes="h2" Text="{l:T 'Where next'}" />
            <ItemsControl ItemsSource="{Binding Goals}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="{DynamicResource Font12}" Foreground="{DynamicResource MapQuest}" Margin="0,1" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <TextBlock Classes="h2" Text="{l:T 'Notes'}" />
          <TextBlock Text="{Binding NoteLabel}" Classes="dim" FontSize="{DynamicResource Font12}" TextWrapping="Wrap" />
          <TextBox x:Name="NoteBox" Text="{Binding NoteText}" AcceptsReturn="False" MaxLength="200" TextWrapping="Wrap" Height="70" Watermark="{l:T 'e.g. Locked door - need a key'}" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="{l:T 'Save note'}" Command="{Binding SaveNoteCommand}" />
            <Button Content="{l:T 'Delete'}" Command="{Binding DeleteNoteCommand}" />
          </StackPanel>
          <TextBlock Text="{l:T 'Click any square on the map to note it.'}" Classes="dim" FontSize="{DynamicResource Font12}" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer Margin="0,8,0,0">
          <ItemsControl ItemsSource="{Binding Notes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="{DynamicResource Font12}" Margin="0,2" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
      <c:MapView x:Name="Map" MapInfo="{Binding MapInfo}" Radius="0" SelectedCell="{Binding SelectedCell}" Revision="{Binding Revision}" />
    </DockPanel>
  </Border>
</UserControl>
