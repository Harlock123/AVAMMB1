<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AVAMMB1.App.ViewModels"
             xmlns:c="using:AVAMMB1.App.Controls"
             xmlns:v="using:AVAMMB1.App.Views"
             x:Class="AVAMMB1.App.Views.GameView"
             x:DataType="vm:GameViewModel">
  <Grid RowDefinitions="*,Auto" ColumnDefinitions="*,380" Margin="8">
    <!-- First-person view -->
    <Border Classes="panel" Padding="4" Margin="0,0,8,8">
      <Grid>
        <c:SceneView Scene="{Binding Scene}" Animate="{Binding SmoothMovement}" AnimateSprites="{Binding AnimateSprites}"
                     ViewHeight="{Binding ViewResolution}" Smooth="{Binding SmoothView}" />
        <v:CombatStageView DataContext="{Binding Combat}" IsVisible="{Binding $parent[UserControl].((vm:GameViewModel)DataContext).InCombat}" />
        <Border VerticalAlignment="Top" HorizontalAlignment="Center" Background="#aa000000" CornerRadius="0,0,6,6" Padding="14,4">
          <TextBlock Text="{Binding LocationText}" Foreground="{DynamicResource Gold}" FontSize="{DynamicResource Font18}" FontWeight="Bold" />
        </Border>
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Background="#aa000000" CornerRadius="6,6,0,0" Padding="12,3">
          <TextBlock Text="{Binding CompassText}" FontSize="{DynamicResource Font14}" />
        </Border>
      </Grid>
    </Border>

    <!-- Side panel -->
    <Border Grid.Column="1" Classes="panel" Margin="0,0,0,8" Padding="8">
      <Grid>
      <v:CombatPanelView DataContext="{Binding Combat}" IsVisible="{Binding $parent[UserControl].((vm:GameViewModel)DataContext).InCombat}" />
      <DockPanel IsVisible="{Binding Exploring}">
        <StackPanel DockPanel.Dock="Top" Spacing="6">
          <c:MapView MapInfo="{Binding MapInfo}" Radius="5" Height="200" IsVisible="{Binding ShowMinimap}" />
          <TextBlock Text="{Binding GoldText}" Foreground="{DynamicResource Gold}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding TimeText}" Classes="dim" TextTrimming="CharacterEllipsis" />
          <!-- Movement -->
          <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto" HorizontalAlignment="Center">
            <Button Classes="nav" Content="&#x21B6;" ToolTip.Tip="Turn left (Left / A)" Command="{Binding TurnLeftCommand}" />
            <Button Grid.Column="1" Classes="nav" Content="&#x2191;" ToolTip.Tip="Forward (Up / W)" Command="{Binding ForwardCommand}" />
            <Button Grid.Column="2" Classes="nav" Content="&#x21B7;" ToolTip.Tip="Turn right (Right / D)" Command="{Binding TurnRightCommand}" />
            <Button Grid.Row="1" Classes="nav" Content="&#x2190;" ToolTip.Tip="Strafe left (Q)" Command="{Binding StrafeLeftCommand}" />
            <Button Grid.Row="1" Grid.Column="1" Classes="nav" Content="&#x2193;" ToolTip.Tip="Back (Down / S)" Command="{Binding BackCommand}" />
            <Button Grid.Row="1" Grid.Column="2" Classes="nav" Content="&#x2192;" ToolTip.Tip="Strafe right (E)" Command="{Binding StrafeRightCommand}" />
          </Grid>
          <UniformGrid Columns="5">
            <UniformGrid.Styles>
              <Style Selector="Button">
                <Setter Property="Padding" Value="0,5" />
                <Setter Property="FontSize" Value="11.5" /> <!-- fixed: the labels just fit -->
              </Style>
            </UniformGrid.Styles>
            <Button Content="Use (Spc)" Command="{Binding InteractCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button Content="Search (F)" Command="{Binding SearchCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Search the walls here for secret doors" />
            <Button Content="Rest (R)" Command="{Binding RestCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button Content="Cast (K)" Command="{Binding CastCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button Content="Party (I)" Command="{Binding CharactersCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button Content="Map (M)" Command="{Binding AutomapCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button Content="Journal (J)" Command="{Binding JournalCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Quests and clues" />
            <Button Content="Note (N)" Command="{Binding NoteCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Write a note on this square of the automap" />
            <Button Content="Menu (Esc)" Command="{Binding MenuCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button Content="Save (F5)" Command="{Binding QuickSaveCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          </UniformGrid>
          <TextBlock Classes="h2" Text="Log" Margin="0,4,0,0" />
        </StackPanel>
        <ScrollViewer x:Name="LogScroller" Background="{DynamicResource ScreenBg}">
          <ItemsControl ItemsSource="{Binding Messages}" Margin="6,4">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MessageViewModel">
                <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" TextWrapping="Wrap" FontSize="{DynamicResource Font13}" Margin="0,1" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
      </Grid>
    </Border>

    <!-- Party roster -->
    <ItemsControl x:Name="PartyBar" Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding Party}">
      <ItemsControl.Styles>
        <Style Selector="ContentPresenter.dragging Border.panel">
          <Setter Property="BorderBrush" Value="{DynamicResource Loot}" />
        </Style>
        <Style Selector="ContentPresenter.droptarget Border.panel">
          <Setter Property="BorderBrush" Value="{DynamicResource Info}" />
          <Setter Property="Background" Value="{DynamicResource CardSelBg}" />
        </Style>
      </ItemsControl.Styles>
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:PartyMemberViewModel">
          <Button Padding="0" Margin="0,0,6,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  Background="Transparent" BorderThickness="0" ToolTip.Tip="Click for the character sheet; drag to change places"
                  Command="{Binding $parent[UserControl].((vm:GameViewModel)DataContext).OpenMemberCommand}" CommandParameter="{Binding}">
            <Border Classes="panel" Padding="6" Classes.active="{Binding IsActive}" Classes.hurt="{Binding IsHurt}">
              <Border.Styles>
                <Style Selector="Border.active">
                  <Setter Property="BorderBrush" Value="{DynamicResource Loot}" />
                  <Setter Property="Background" Value="{DynamicResource CardSelBg}" />
                </Style>
                <Style Selector="Border.hurt">
                  <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
                  <Setter Property="Background" Value="{DynamicResource CardDangerBg}" />
                  <Style.Animations>
                    <Animation Duration="0:0:0.45">
                      <KeyFrame Cue="0%"><Setter Property="TranslateTransform.X" Value="0" /></KeyFrame>
                      <KeyFrame Cue="25%"><Setter Property="TranslateTransform.X" Value="-5" /></KeyFrame>
                      <KeyFrame Cue="50%"><Setter Property="TranslateTransform.X" Value="4" /></KeyFrame>
                      <KeyFrame Cue="75%"><Setter Property="TranslateTransform.X" Value="-2" /></KeyFrame>
                      <KeyFrame Cue="100%"><Setter Property="TranslateTransform.X" Value="0" /></KeyFrame>
                    </Animation>
                  </Style.Animations>
                </Style>
              </Border.Styles>
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                <Border Grid.RowSpan="3" Background="{DynamicResource ScreenBg}" Margin="0,0,6,0" CornerRadius="2">
                  <c:PixelImage Source="{Binding Portrait}" Width="48" Height="48" />
                </Border>
                <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                  <Border Grid.Column="1" VerticalAlignment="Top" Margin="4,0,0,0"
                          Background="{DynamicResource BadgeBg}" CornerRadius="3" Padding="4,0" IsVisible="{Binding !IsOk}">
                    <TextBlock Text="{Binding Status}" FontSize="{DynamicResource Font11}" />
                  </Border>
                </Grid>
                <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding ClassLevel}" Classes="dim" FontSize="{DynamicResource Font11}" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Horizontal" Spacing="8">
                  <TextBlock FontSize="{DynamicResource Font12}"><Run Text="AC " Foreground="{DynamicResource Dim}" /><Run Text="{Binding ArmorClass}" /></TextBlock>
                  <TextBlock FontSize="{DynamicResource Font12}"><Run Text="Food " Foreground="{DynamicResource Dim}" /><Run Text="{Binding Food}" /></TextBlock>
                  <TextBlock FontSize="{DynamicResource Font12}" Text="LVL!" Foreground="{DynamicResource Good}" IsVisible="{Binding CanLevel}" FontWeight="Bold" />
                </StackPanel>
                <Grid Grid.Row="3" Grid.ColumnSpan="2" ColumnDefinitions="26,*,60" Margin="0,4,0,0">
                  <TextBlock Text="HP" FontSize="{DynamicResource Font11}" Classes="dim" />
                  <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding HpFraction}" Foreground="{DynamicResource HpBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding HpText}" FontSize="{DynamicResource Font11}" HorizontalAlignment="Right" />
                </Grid>
                <Grid Grid.Row="4" Grid.ColumnSpan="2" ColumnDefinitions="26,*,60">
                  <TextBlock Text="SP" FontSize="{DynamicResource Font11}" Classes="dim" />
                  <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding SpFraction}" Foreground="{DynamicResource SpBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding SpText}" FontSize="{DynamicResource Font11}" HorizontalAlignment="Right" />
                </Grid>
              </Grid>
            </Border>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Overlay dialogs -->
    <Border x:Name="OverlayHost" Grid.ColumnSpan="2" Background="#99000000" IsVisible="{Binding HasOverlay}" Margin="0,0,0,8">
      <ContentControl Content="{Binding Overlay}" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
  </Grid>
</UserControl>
