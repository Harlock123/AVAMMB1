<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AVAMMB1.App.ViewModels"
             xmlns:c="using:AVAMMB1.App.Controls"
             x:Class="AVAMMB1.App.Views.ShopView" x:DataType="vm:ShopViewModel">
  <Border Classes="dialog" Width="1000" Height="540">
    <Grid RowDefinitions="Auto,Auto,*,Auto" ColumnDefinitions="*,16,*">
      <TextBlock Grid.ColumnSpan="3" Classes="title" Text="{Binding Title}" />
      <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="10" Margin="0,6">
        <TextBlock Text="Shopping for:" VerticalAlignment="Center" Classes="dim" />
        <ComboBox ItemsSource="{Binding Members}" SelectedItem="{Binding SelectedMember}" MinWidth="200">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PartyMemberViewModel">
              <TextBlock><Run Text="{Binding Name}" /><Run Text=" - " /><Run Text="{Binding ClassLevel}" /></TextBlock>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="{Binding SpendText}" Foreground="{DynamicResource Gold}" VerticalAlignment="Center" FontWeight="Bold" />
      </StackPanel>
      <DockPanel Grid.Row="2">
        <TextBlock DockPanel.Dock="Top" Classes="h2" Text="For Sale" />
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Stock}" Margin="0,0,16,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ShopItemViewModel">
                <Grid ColumnDefinitions="40,*,70,Auto" Margin="0,1">
                  <c:PixelImage Source="{Binding Icon}" Width="32" Height="32" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Summary}" FontSize="{DynamicResource Font11}" Classes="dim" />
                    <TextBlock Text="{Binding Compare}" FontSize="{DynamicResource Font11}" IsVisible="{Binding HasCompare}" TextWrapping="Wrap"
                               Classes.up="{Binding IsUpgrade}">
                      <TextBlock.Styles>
                        <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Info}" /></Style>
                        <Style Selector="TextBlock.up"><Setter Property="Foreground" Value="{DynamicResource Good}" /></Style>
                      </TextBlock.Styles>
                    </TextBlock>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Price, StringFormat='{}{0} gp'}" VerticalAlignment="Center" Foreground="{DynamicResource Gold}" />
                  <Button Grid.Column="3" Classes="chip" Content="Buy" Command="{Binding $parent[UserControl].((vm:ShopViewModel)DataContext).BuyCommand}" CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
      <DockPanel Grid.Row="2" Grid.Column="2">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,16,0">
          <TextBlock Classes="h2" Text="{Binding RightTitle}" />
          <Button Grid.Column="1" Classes="chip" Content="{Binding JunkText}" Command="{Binding SellJunkCommand}" IsEnabled="{Binding HasJunk}" ToolTip.Tip="{Binding JunkTip}" VerticalAlignment="Center"
                  IsVisible="{Binding !ShowSmithing}" />
          <Button Grid.Column="2" Classes="chip" Content="{Binding SmithingLabel}" Command="{Binding ToggleSmithingCommand}" IsVisible="{Binding IsSmithy}" VerticalAlignment="Center" Margin="4,0,0,0"
                  ToolTip.Tip="Have the smith improve weapons and armor, +1 to +5" />
        </Grid>
        <TextBlock DockPanel.Dock="Top" Text="{Binding GemsText}" IsVisible="{Binding ShowSmithing}" Classes="dim" FontSize="{DynamicResource Font11}" TextWrapping="Wrap" Margin="0,0,16,4" />
        <ScrollViewer IsVisible="{Binding ShowSmithing}">
          <ItemsControl ItemsSource="{Binding Upgrades}" Margin="0,0,16,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:UpgradeRow">
                <Grid ColumnDefinitions="40,*,Auto" Margin="0,1">
                  <c:PixelImage Source="{Binding Icon}" Width="32" Height="32" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock><Run Text="{Binding Name}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Where}" Foreground="{DynamicResource Dim}" /></TextBlock>
                    <TextBlock Text="{Binding Cost}" FontSize="{DynamicResource Font11}" Foreground="{DynamicResource Gold}" />
                  </StackPanel>
                  <Button Grid.Column="2" Classes="chip" Content="Improve" IsEnabled="{Binding CanUpgrade}"
                          Command="{Binding $parent[UserControl].((vm:ShopViewModel)DataContext).UpgradeItemCommand}" CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <ScrollViewer IsVisible="{Binding !ShowSmithing}">
          <ItemsControl ItemsSource="{Binding Sellable}" Margin="0,0,16,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ShopItemViewModel">
                <Grid ColumnDefinitions="40,*,70,Auto" Margin="0,1">
                  <c:PixelImage Source="{Binding Icon}" Width="32" Height="32" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Text="not needed by anyone" IsVisible="{Binding IsJunk}" FontSize="{DynamicResource Font11}" Classes="dim" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Price, StringFormat='{}{0} gp'}" VerticalAlignment="Center" Foreground="{DynamicResource Gold}" />
                  <Button Grid.Column="3" Classes="chip" Content="Sell" Command="{Binding $parent[UserControl].((vm:ShopViewModel)DataContext).SellCommand}" CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
      <Grid Grid.Row="3" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
        <TextBlock Text="{Binding Feedback}" TextWrapping="Wrap" Foreground="{DynamicResource Info}" />
        <Button Grid.Column="1" Content="Leave (Esc)" Command="{Binding LeaveCommand}" />
      </Grid>
    </Grid>
  </Border>
</UserControl>
