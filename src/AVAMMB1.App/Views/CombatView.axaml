<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AVAMMB1.App.ViewModels"
             xmlns:c="using:AVAMMB1.App.Controls"
             x:Class="AVAMMB1.App.Views.CombatView"
             x:DataType="vm:CombatViewModel">
  <UserControl.Styles>
    <!-- Idle "breathing": two variants with different tempos so a group doesn't move in lock-step. -->
    <Style Selector="c|PixelImage.idleA">
      <Style.Animations>
        <Animation Duration="0:0:1.8" IterationCount="INFINITE" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="0" /><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="TranslateTransform.Y" Value="-4" /><Setter Property="ScaleTransform.ScaleX" Value="1.03" /><Setter Property="ScaleTransform.ScaleY" Value="1.03" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="0" /><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="c|PixelImage.idleB">
      <Style.Animations>
        <Animation Duration="0:0:2.3" IterationCount="INFINITE" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="-2" /><Setter Property="ScaleTransform.ScaleX" Value="1.02" /><Setter Property="ScaleTransform.ScaleY" Value="1.02" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="TranslateTransform.Y" Value="2" /><Setter Property="ScaleTransform.ScaleX" Value="0.99" /><Setter Property="ScaleTransform.ScaleY" Value="0.99" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="-2" /><Setter Property="ScaleTransform.ScaleX" Value="1.02" /><Setter Property="ScaleTransform.ScaleY" Value="1.02" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- Card defaults live in styles (not local values) so the state styles below can override them. -->
    <Style Selector="Border.card">
      <Setter Property="BorderBrush" Value="#30ffffff" />
      <Setter Property="Background" Value="#40000000" />
    </Style>
    <Style Selector="Border.card.selected">
      <Setter Property="BorderBrush" Value="#ff5040" />
      <Setter Property="Background" Value="#40501010" />
    </Style>
    <!-- Attack: lunge toward the party. -->
    <Style Selector="Border.card.attacking">
      <Setter Property="BorderBrush" Value="#ffb060" />
      <Style.Animations>
        <Animation Duration="0:0:0.45" Easing="CubicEaseOut">
          <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="0" /><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
          <KeyFrame Cue="35%"><Setter Property="TranslateTransform.Y" Value="12" /><Setter Property="ScaleTransform.ScaleX" Value="1.14" /><Setter Property="ScaleTransform.ScaleY" Value="1.14" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="0" /><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- Hit: white flash and a shake. -->
    <Style Selector="Border.card.hit">
      <Setter Property="BorderBrush" Value="#ffffff" />
      <Setter Property="Background" Value="#55ffffff" />
      <Style.Animations>
        <Animation Duration="0:0:0.42">
          <KeyFrame Cue="0%"><Setter Property="TranslateTransform.X" Value="0" /></KeyFrame>
          <KeyFrame Cue="20%"><Setter Property="TranslateTransform.X" Value="-7" /></KeyFrame>
          <KeyFrame Cue="40%"><Setter Property="TranslateTransform.X" Value="6" /></KeyFrame>
          <KeyFrame Cue="60%"><Setter Property="TranslateTransform.X" Value="-4" /></KeyFrame>
          <KeyFrame Cue="80%"><Setter Property="TranslateTransform.X" Value="2" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="TranslateTransform.X" Value="0" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- Slain monsters fade out and stay faded until the battle ends. -->
    <Style Selector="Border.card.dead">
      <Setter Property="Opacity" Value="0.25" />
    </Style>
  </UserControl.Styles>
  <Border Classes="dialog" Width="1100" Height="560" Padding="12">
    <Grid ColumnDefinitions="*,330" RowDefinitions="Auto,*,Auto">
      <Grid ColumnDefinitions="*,Auto" Grid.ColumnSpan="2" Margin="0,0,0,6">
        <TextBlock Classes="title" Text="Battle!" />
        <TextBlock Grid.Column="1" Text="{Binding RoundText}" Classes="dim" VerticalAlignment="Center" />
      </Grid>

      <!-- Monster line-up -->
      <Border Grid.Row="1" Background="#0b0a10" CornerRadius="4" Padding="6" Margin="0,0,10,0">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#1a1626" Offset="0" />
            <GradientStop Color="#2a1a14" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Monsters}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MonsterViewModel">
                <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="4"
                        Command="{Binding $parent[UserControl].((vm:CombatViewModel)DataContext).TargetCommand}" CommandParameter="{Binding}">
                  <Border Classes="card" Width="150" Padding="6" CornerRadius="4" BorderThickness="2"
                          Classes.selected="{Binding IsSelected}" Classes.hit="{Binding IsHit}"
                          Classes.attacking="{Binding IsAttacking}" Classes.dead="{Binding IsDead}">
                    <Border.Transitions>
                      <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.8" Easing="QuadraticEaseOut" />
                      </Transitions>
                    </Border.Transitions>
                    <StackPanel Spacing="2">
                      <c:PixelImage Source="{Binding Sprite}" Width="96" Height="96" HorizontalAlignment="Center"
                                    Classes.idleA="{Binding IdleA}" Classes.idleB="{Binding IdleB}" />
                      <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                      <ProgressBar Minimum="0" Maximum="1" Value="{Binding HpFraction}" Foreground="{StaticResource HpBrush}" />
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                        <TextBlock Text="front" FontSize="11" Foreground="#ffb060" IsVisible="{Binding IsFront}" />
                        <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#9fd0ff" />
                        <TextBlock Text="slain" FontSize="11" Foreground="#ff8a7a" IsVisible="{Binding IsDead}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <!-- Log -->
      <ScrollViewer Grid.Row="1" Grid.Column="1" x:Name="LogScroller" Background="#0b0a10">
        <ItemsControl ItemsSource="{Binding Log}" Margin="6,4">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MessageViewModel">
              <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" TextWrapping="Wrap" FontSize="13" Margin="0,1" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- Controls -->
      <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0" Spacing="6">
        <TextBlock Text="{Binding Prompt}" FontSize="16" Foreground="{StaticResource Gold}" />
        <StackPanel Orientation="Horizontal" IsVisible="{Binding IsOpening}">
          <Button Content="Fight (F)" Command="{Binding FightCommand}" FontWeight="Bold" />
          <Button Content="{Binding RunText}" Command="{Binding FleeCommand}" />
          <Button Content="{Binding BribeLabel}" Command="{Binding BribeCommand}" IsEnabled="{Binding CanBribe}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" IsVisible="{Binding IsAction}">
          <Button Content="Attack (A)" Command="{Binding AttackCommand}" IsEnabled="{Binding CanMelee}" FontWeight="Bold" />
          <Button Content="Shoot (S)" Command="{Binding ShootCommand}" IsEnabled="{Binding CanShoot}" />
          <Button Content="Cast (C)" Command="{Binding ShowSpellsCommand}" IsEnabled="{Binding CanCast}" />
          <Button Content="Use Item (U)" Command="{Binding ShowItemsCommand}" />
          <Button Content="Block (B)" Command="{Binding BlockCommand}" />
          <Button Content="{Binding RunText}" Command="{Binding RunCommand}" />
          <TextBlock Text="  1-9 / click: choose target" Classes="dim" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel IsVisible="{Binding IsChoosing}">
          <ItemsControl ItemsSource="{Binding Choices}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CombatChoice">
                <Button Content="{Binding Label}" IsEnabled="{Binding Enabled}"
                        Command="{Binding $parent[UserControl].((vm:CombatViewModel)DataContext).ChooseCommand}" CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="Cancel (Esc)" Command="{Binding CancelCommand}" HorizontalAlignment="Left" />
        </StackPanel>
        <StackPanel IsVisible="{Binding IsAlly}" Orientation="Horizontal">
          <ItemsControl ItemsSource="{Binding Party}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PartyMemberViewModel">
                <Button Command="{Binding $parent[UserControl].((vm:CombatViewModel)DataContext).ChooseAllyCommand}" CommandParameter="{Binding}">
                  <TextBlock><Run Text="{Binding Slot}" /><Run Text=". " /><Run Text="{Binding Name}" /><Run Text=" " /><Run Text="{Binding HpText}" /></TextBlock>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="Cancel" Command="{Binding CancelCommand}" />
        </StackPanel>
        <Button Content="Continue (Enter)" Command="{Binding ContinueCommand}" IsVisible="{Binding IsFinished}" FontWeight="Bold" HorizontalAlignment="Left" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
